# Copy to .env and fill in. Real environment variables (DDEV, PHP-FPM, nginx) override this file.

# Required: signs Datastar template configs and the Opcache warm-up request.
# Generate with: openssl rand -hex 32
APP_SECRET=

# 1 = no caches, drafts visible, Vite dev server. Leave empty/0 in production.
APP_DEBUG=0

# Optional: base URL bin/console deploy uses to reach PHP-FPM (default http://127.0.0.1)
# APP_WARM_URL=http://127.0.0.1
