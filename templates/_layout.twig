<!doctype html>
<html lang="{{ site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# First in <head>: sets data-theme (light/dark) before anything is painted, so there's no flash. #}
    {{ theme_script() }}
    {# Pages set their metadata here ({% do seo.title('…') %}) or in their controller; printed once below. #}
    {% block seo %}{% endblock %}
    {{ seo_tags() }}
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} — {{ 'Blog'|t }}" href="{{ path('blog_feed') }}">
    {# Values from config/app.php `public` for page scripts (only those: it's an allowlist). #}
    {{ public_config() }}
    {# The self-hosted font's main file (resources/css/app.css), so text doesn't wait for the CSS to be parsed. #}
    {{ vite_preload('node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2') }}
    {# Pages add their own bundles with {% set page_scripts = ['resources/js/pages/<name>.js'] %}. #}
    {{ vite('resources/js/app.js', page_scripts ?? []) }}
</head>
<body class="min-h-screen bg-page text-ink antialiased">
    <header class="border-b border-line bg-surface">
        <nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4">
            <a href="{{ path('home') }}" class="flex items-center gap-1.5 font-semibold tracking-tight"><span class="icon-[app--starlite] size-5" aria-hidden="true"></span>{{ site.name }}</a>
            <a href="{{ path('blog') }}" class="text-muted hover:text-strong">{{ 'Blog'|t }}</a>
            <div class="ml-auto flex items-center gap-4">
                {% include '_partials/language-switcher.twig' %}
                {% include '_partials/theme-switcher.twig' %}
            </div>
        </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
        {% block content %}{% endblock %}
    </main>
    <footer class="border-t border-line">
        {# Top-level content pages (content/pages/*/), in their `order`: a menu is just a query. #}
        <nav class="mx-auto flex max-w-3xl flex-wrap gap-x-6 gap-y-2 px-4 py-6 text-sm" aria-label="{{ 'Site'|t }}">
            {% for item in pages().where('parent', '').orderBy('order, title') %}
                <a href="{{ path('page', {path: item.path}) }}" class="text-muted hover:text-strong">{{ item.title }}</a>
            {% endfor %}
        </nav>
    </footer>
</body>
</html>
