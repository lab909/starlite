<!doctype html>
<html lang="{{ site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Pages set their metadata here ({% do seo.title('…') %}) or in their controller; printed once below. #}
    {% block seo %}{% endblock %}
    {{ seo_tags() }}
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} — {{ 'Blog'|t }}" href="{{ path('blog_feed') }}">
    {# Values from config/app.php `public` for page scripts (only those: it's an allowlist). #}
    {{ public_config() }}
    {# Pages add their own bundles with {% set page_scripts = ['resources/js/pages/<name>.js'] %}. #}
    {{ vite('resources/js/app.js', page_scripts ?? []) }}
</head>
<body class="min-h-screen bg-stone-50 text-stone-800 antialiased">
    <header class="border-b border-stone-200 bg-white">
        <nav class="mx-auto flex max-w-3xl items-center gap-6 px-4 py-4">
            <a href="{{ path('home') }}" class="font-semibold tracking-tight">{{ site.name }}</a>
            <a href="{{ path('blog') }}" class="text-stone-600 hover:text-stone-900">{{ 'Blog'|t }}</a>
            {% include '_partials/language-switcher.twig' %}
        </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
        {% block content %}{% endblock %}
    </main>
</body>
</html>
