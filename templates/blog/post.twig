{% extends '_layout.twig' %}

{% block title %}{{ post.title }} · Starlite{% endblock %}

{% block meta %}
    <meta name="description" content="{{ post.summary }}">
{% endblock %}

{% block content %}
    <article>
        <header class="mb-8">
            <p class="text-sm text-stone-500">
                <time datetime="{{ post.date }}">{{ post.date|date('F j, Y') }}</time> · {{ post.reading_minutes }} min read
            </p>
            <h1 class="mt-1 text-4xl font-bold tracking-tight">{{ post.title }}</h1>
            {% if post.tags %}
                <p class="mt-3 flex flex-wrap gap-2 text-sm">
                    {% for tag in post.tags %}<span class="rounded-full bg-stone-200 px-3 py-0.5">{{ tag }}</span>{% endfor %}
                </p>
            {% endif %}
        </header>

        {# Safe: Markdown is rendered with raw HTML escaped and unsafe links removed (lib/src/Blog/MarkdownParser.php). #}
        <div class="prose prose-stone max-w-none">{{ post.html|raw }}</div>
    </article>

    <p class="mt-12"><a href="{{ path('blog') }}" class="text-stone-600 hover:underline">← All posts</a></p>
{% endblock %}
