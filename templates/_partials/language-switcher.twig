{# The current page in every configured language; hidden when the site has only one.
   Where the page doesn't exist in a language (an untranslated post), its link goes to a fallback. #}
{% set languages = language_switcher() %}
{% if languages|length > 1 %}
    <ul class="flex gap-3 text-sm" aria-label="{{ 'Language'|t }}">
        {% for language in languages %}
            <li>
                {% if language.active %}
                    <span aria-current="true" class="font-semibold">{{ language.name }}</span>
                {% else %}
                    {# Not available: the link goes to that language's fallback (e.g. its blog), so it's no hreflang alternate. #}
                    <a href="{{ language.url }}" lang="{{ language.code }}"{% if language.available %} hreflang="{{ language.code }}"{% endif %}
                       class="text-subtle hover:text-strong">{{ language.name }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
