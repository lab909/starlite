# Static analysis for the app and its tests: `composer analyse`. The framework has its own.
# Level 8 checks types, nullability and array shapes; level 9's strict `mixed` rules mostly flag
# SPL iterators and console options, so they would add annotations without catching real bugs.
parameters:
    level: 8
    paths:
        - src
        - tests
        - config
    excludePaths:
        - tests/data/*
    tmpDir: var/phpstan
