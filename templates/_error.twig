{% extends '_layout.twig' %}

{% block seo %}{% do seo.title(status ~ ' ' ~ message) %}{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold tracking-tight">{{ status }}</h1>
    <p class="mt-2 text-muted">{{ message }}</p>
    <p class="mt-6"><a href="{{ path('home') }}" class="hover:underline">{{ '← Home'|t }}</a></p>
{% endblock %}
