# Static analysis for the framework (lib/), the app and the tests: `composer analyse`.
# Level 8 checks types, nullability and array shapes; level 9's strict `mixed` rules mostly flag
# SPL iterators and console options, so they would add annotations without catching real bugs.
parameters:
    level: 8
    paths:
        - lib/src
        - lib/tests
        - src
        - tests
        - config
    excludePaths:
        - lib/tests/data/*
        - tests/data/*
    tmpDir: var/phpstan
