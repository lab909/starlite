<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Starlite{% endblock %}</title>
    {% block meta %}{% endblock %}
    {{ vite('resources/js/app.js') }}
</head>
<body class="min-h-screen bg-stone-50 text-stone-800 antialiased">
    <header class="border-b border-stone-200 bg-white">
        <nav class="mx-auto flex max-w-3xl items-center gap-6 px-4 py-4">
            <a href="{{ path('home') }}" class="font-semibold tracking-tight">Starlite</a>
            <a href="{{ path('blog') }}" class="text-stone-600 hover:text-stone-900">Blog</a>
        </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
        {% block content %}{% endblock %}
    </main>
</body>
</html>
