# Copy to .env and fill in. Real environment variables (DDEV, PHP-FPM, nginx) override this file.

# Required: signs Datastar template configs.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Required: public base URL (canonical links, Open Graph, sitemap, feed). No trailing slash.
APP_URL=https://example.com

# 1 = no caches, drafts visible, Vite dev server, Symfony exception pages. Leave empty/0 in production.
APP_DEBUG=0

# Optional: serve post and page files and video posters from a CDN that pulls them from this site
# (https only, no trailing slash). Empty: from this site, /media/…
# MEDIA_URL=https://cdn.example.com

# Email for forms (Symfony Mailer): how to send, and from which address (one of your own domain).
# The contact form goes to CONTACT_TO (comma-separated for several). DDEV sets these to its Mailpit.
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
# MAILER_FROM=hello@example.com
# CONTACT_TO=you@example.com

# Optional: blog posts per page (default 20). A low value like 1 makes pagination easy to test.
# BLOG_PER_PAGE=20

# Optional: reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or REMOTE_ADDR)
# APP_TRUSTED_PROXIES=

# Optional, for bin/console deploy: how to refresh the web server's Opcache (see README, "Production setups")
#   cachetool = PHP-FPM, precompile everything (default) | reload = run APP_OPCACHE_RELOAD_CMD | none
# APP_OPCACHE=cachetool
# APP_FPM_SOCKET=/run/php-fpm.sock
# APP_CACHETOOL=cachetool
# APP_OPCACHE_RELOAD_CMD="sudo systemctl reload php8.4-fpm"
