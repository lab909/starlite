{% extends '_layout.twig' %}

{# SEO metadata comes from the post's front matter (Starlite\Blog\PostSeo, applied in BlogController). #}

{% block content %}
    <article>
        <header class="mb-8">
            <p class="text-sm text-subtle">
                <time datetime="{{ post.date }}">{{ post.date|format_date('long', locale: site.locale) }}</time> · {{ '{minutes} min read'|t({minutes: post.reading_minutes}) }}
            </p>
            <h1 class="mt-1 text-4xl font-bold tracking-tight">{{ post.title }}</h1>
            {% if post.tags %}
                <p class="mt-3 flex flex-wrap gap-2 text-sm">
                    {% for tag in post.tags %}<span class="rounded-full bg-chip px-3 py-0.5">{{ tag }}</span>{% endfor %}
                </p>
            {% endif %}
        </header>

        {% if post.image %}
            <img src="{{ post.image }}" alt="" class="mb-8 w-full rounded-lg">
        {% endif %}

        {# Safe: Markdown is rendered with raw HTML escaped and unsafe links removed (lib/src/Blog/MarkdownParser.php). #}
        <div class="prose prose-stone dark:prose-invert max-w-none">{{ post.html|raw }}</div>
    </article>

    <p class="mt-12"><a href="{{ path('blog') }}" class="text-muted hover:underline">{{ '← All posts'|t }}</a></p>
{% endblock %}
